meta {
  name: Create Auction
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auctions
  body: json
  auth: bearer
}

auth:bearer {
  token: {{sellerToken}}
}

body:json {
  {
    "productId": "{{productId}}",
    "startPrice": 10,
    "reservePrice": 50,
    "startAt": "2026-06-04T00:00:00Z",
    "endAt": "2026-06-04T23:59:00Z"
  }
}
